{
  "productName": "Zombie Farm 游戏管理",
  "version": "0.1.0",
  "identifier": "cn.zombiefarm.manager",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "Zombie Farm 游戏管理 · 免费开源",
      "width": 920,
      "height": 740,
      "minWidth": 440,
      "minHeight": 420,
      "center": true,
      "dragDropEnabled": false
    }],
    "security": {
      "capabilities": [{
        "identifier": "manager",
        "windows": ["main"],
        "permissions": ["core:event:allow-listen", "core:event:allow-unlisten"]
      }],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": { "active": false, "icon": ["../../touchHLE/touchHLE-fork/res/zombie_farm_icon.ico"] }
}
